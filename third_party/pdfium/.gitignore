# The fetched payload. Reproduced by fetch_pdfium.sh from the pin in VERSION;
# never committed (see README.md, "Why the binary is fetched rather than
# committed"). Listed per platform rather than as a wildcard so that adding a
# platform is a visible edit here, not something that silently disappears.
/mac-arm64/
/mac-x64/
/linux-x64/
/linux-arm64/
/android-arm64/
/ios-device-arm64/
/ios-simulator-arm64/
